{
  "$id": "https://chatwaifu.local/schemas/domain/v1/sticker-usage-record.schema.json",
  "description": "One retained image part, not a counter of attempts or user preference.",
  "properties": {
    "attempt": {
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "delivered_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivered At"
    },
    "label": {
      "maxLength": 80,
      "minLength": 1,
      "title": "Label",
      "type": "string"
    },
    "origin": {
      "enum": [
        "preset",
        "learned"
      ],
      "title": "Origin",
      "type": "string"
    },
    "part_id": {
      "format": "uuid",
      "title": "Part Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "pending",
        "sending",
        "delivered",
        "failed",
        "cancelled",
        "skipped"
      ],
      "title": "Status",
      "type": "string"
    },
    "sticker_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "title": "Sticker Id",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "part_id",
    "sticker_id",
    "label",
    "origin",
    "status",
    "attempt",
    "created_at",
    "updated_at"
  ],
  "title": "StickerUsageRecord",
  "type": "object",
  "x-schema-version": "1.0"
}
