      "format": "date-time",
      "title": "Checked At",
      "type": "string"
    },
    "enabled_connection_count": {
      "minimum": 0,
      "title": "Enabled Connection Count",
      "type": "integer"
    },
    "provider_count": {
      "minimum": 0,
      "title": "Provider Count",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
