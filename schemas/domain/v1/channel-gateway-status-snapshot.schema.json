        "ready",
        "degraded",
        "error"
      ],
      "title": "ChannelGatewayStatus",
      "type": "string"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/channel-gateway-status-snapshot.schema.json",
  "description": "Aggregate health for the provider-neutral channel gateway.",
  "properties": {
