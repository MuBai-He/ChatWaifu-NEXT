{
  "$defs": {
    "ChannelDeliveryPartKind": {
      "enum": [
        "text",
        "image"
      ],
      "title": "ChannelDeliveryPartKind",
      "type": "string"
    },
    "ChannelDeliveryPartStatus": {
      "enum": [
        "pending",
        "sending",
        "delivered",
        "failed",
        "cancelled",
        "skipped"
      ],
      "title": "ChannelDeliveryPartStatus",
      "type": "string"
    },
    "ChannelImageDeliveryPartPayload": {
      "properties": {
        "kind": {
          "const": "image",
          "default": "image",
          "title": "Kind",
          "type": "string"
        },
        "mime_type": {
          "description": "MIME media type of the local image bytes",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^image/[a-zA-Z0-9.+-]+$",
          "title": "Mime Type",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "description": "Lowercase SHA-256 digest of the verified local image bytes",
          "maxLength": 64,
          "minLength": 64,
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "sticker_id": {
          "description": "Immutable identifier of the local preset sticker asset",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_-]+$",
          "title": "Sticker Id",
          "type": "string"
        }
      },
      "required": [
        "sticker_id",
        "sha256",
        "mime_type"
      ],
      "title": "ChannelImageDeliveryPartPayload",
      "type": "object"
    },
    "ChannelTextDeliveryPartPayload": {
      "properties": {
        "kind": {
          "const": "text",
          "default": "text",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "text": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "ChannelTextDeliveryPartPayload",
      "type": "object"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "StructuredError": {
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "component"
      ],
      "title": "StructuredError",
      "type": "object"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/channel-delivery-part-snapshot.schema.json",
  "properties": {
    "attempt": {
      "default": 0,
      "minimum": 0,
      "title": "Attempt",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "delay_after_ms": {
      "default": 0,
      "maximum": 60000,
      "minimum": 0,
      "title": "Delay After Ms",
      "type": "integer"
    },
    "delivered_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivered At"
    },
    "delivery_id": {
      "format": "uuid",
      "title": "Delivery Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/ChannelDeliveryPartKind",
      "default": "text"
    },
    "last_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructuredError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "lease_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Id"
    },
    "not_before_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Not Before At"
    },
    "ordinal": {
      "minimum": 0,
      "title": "Ordinal",
      "type": "integer"
    },
    "part_id": {
      "format": "uuid",
      "title": "Part Id",
      "type": "string"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "image": "#/$defs/ChannelImageDeliveryPartPayload",
          "text": "#/$defs/ChannelTextDeliveryPartPayload"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ChannelTextDeliveryPartPayload"
        },
        {
          "$ref": "#/$defs/ChannelImageDeliveryPartPayload"
        }
      ],
      "title": "Payload"
    },
    "provider_client_id": {
      "maxLength": 512,
      "minLength": 1,
      "title": "Provider Client Id",
      "type": "string"
    },
    "provider_message_id": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Provider Message Id"
    },
    "required": {
      "default": true,
      "title": "Required",
      "type": "boolean"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ChannelDeliveryPartStatus"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "part_id",
    "delivery_id",
    "ordinal",
    "payload",
    "status",
    "provider_client_id",
    "created_at",
    "updated_at"
  ],
  "title": "ChannelDeliveryPartSnapshot",
  "type": "object",
  "x-schema-version": "1.0"
}
