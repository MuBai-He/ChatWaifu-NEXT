{
  "$defs": {
    "ChannelDeliveryStatus": {
      "enum": [
        "pending",
        "sending",
        "delivered",
        "failed",
        "cancelled"
      ],
      "title": "ChannelDeliveryStatus",
      "type": "string"
    },
    "ChannelOutboundIntentSnapshot": {
      "description": "Intent lifecycle and actual provider facts remain separate.\n\nA settled cancellation does not erase a provider success which arrived\nduring cancellation. UI must also display delivery_status/receipt presence.",
      "properties": {
        "binding_id": {
          "format": "uuid",
          "title": "Binding Id",
          "type": "string"
        },
        "cancel_reason": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancel Reason"
        },
        "cancel_requested_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cancel Requested At"
        },
        "cancelable": {
          "default": false,
          "title": "Cancelable",
          "type": "boolean"
        },
        "connection_id": {
          "format": "uuid",
          "title": "Connection Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "delivery_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Id"
        },
        "delivery_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChannelDeliveryStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuredError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "not_before_at": {
          "format": "date-time",
          "title": "Not Before At",
          "type": "string"
        },
        "policy_revision": {
          "minimum": 0,
          "title": "Policy Revision",
          "type": "integer"
        },
        "provider_receipt_present": {
          "default": false,
          "title": "Provider Receipt Present",
          "type": "boolean"
        },
        "reply_text": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply Text"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "route_revision": {
          "minimum": 0,
          "title": "Route Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "settled_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settled At"
        },
        "settled_reason": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Settled Reason"
        },
        "source": {
          "const": "idle_check_in",
          "default": "idle_check_in",
          "title": "Source",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ChannelOutboundIntentStatus"
        },
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "request_id",
        "connection_id",
        "binding_id",
        "session_id",
        "turn_id",
        "generation_id",
        "status",
        "policy_revision",
        "route_revision",
        "revision",
        "not_before_at",
        "expires_at",
        "created_at",
        "updated_at"
      ],
      "title": "ChannelOutboundIntentSnapshot",
      "type": "object"
    },
    "ChannelOutboundIntentStatus": {
      "enum": [
        "pending",
        "generating",
        "planned",
        "settled"
      ],
      "title": "ChannelOutboundIntentStatus",
      "type": "string"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "StructuredError": {
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "component"
      ],
      "title": "StructuredError",
      "type": "object"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/channel-outbound-intent-page.schema.json",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ChannelOutboundIntentSnapshot"
      },
      "maxItems": 50,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "ChannelOutboundIntentPage",
  "type": "object",
  "x-schema-version": "1.0"
}
