{
  "$defs": {
    "DiagnosticDeliveryPart": {
      "properties": {
        "attempt": {
          "title": "Attempt",
          "type": "integer"
        },
        "delivered_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivered At"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "ordinal": {
          "title": "Ordinal",
          "type": "integer"
        },
        "part_id": {
          "format": "uuid",
          "title": "Part Id",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "part_id",
        "ordinal",
        "kind",
        "required",
        "status",
        "attempt"
      ],
      "title": "DiagnosticDeliveryPart",
      "type": "object"
    },
    "DiagnosticMemoryReference": {
      "properties": {
        "currently_visible": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currently Visible"
        },
        "memory_id": {
          "format": "uuid",
          "title": "Memory Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "selected_for_prompt": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected For Prompt"
        }
      },
      "required": [
        "memory_id"
      ],
      "title": "DiagnosticMemoryReference",
      "type": "object"
    },
    "DiagnosticPlaybackSegment": {
      "properties": {
        "played_pts_ms": {
          "title": "Played Pts Ms",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "segment_id": {
          "format": "uuid",
          "title": "Segment Id",
          "type": "string"
        },
        "segment_index": {
          "title": "Segment Index",
          "type": "integer"
        },
        "state": {
          "title": "State",
          "type": "string"
        },
        "transport": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Transport"
        }
      },
      "required": [
        "segment_id",
        "segment_index",
        "state",
        "played_pts_ms"
      ],
      "title": "DiagnosticPlaybackSegment",
      "type": "object"
    },
    "DiagnosticResponsePlan": {
      "properties": {
        "expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expression"
        },
        "intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Intent"
        },
        "motion": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Motion"
        },
        "response_length": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response Length"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tone"
        }
      },
      "title": "DiagnosticResponsePlan",
      "type": "object"
    },
    "DiagnosticTimelineItem": {
      "properties": {
        "event_type": {
          "title": "Event Type",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sequence": {
          "title": "Sequence",
          "type": "integer"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
      },
      "required": [
        "sequence",
        "event_type",
        "occurred_at"
      ],
      "title": "DiagnosticTimelineItem",
      "type": "object"
    },
    "DiagnosticToolCall": {
      "properties": {
        "duration_ms": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Ms"
        },
        "error_code": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Code"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "tool_call_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tool Call Id"
        }
      },
      "required": [
        "status"
      ],
      "title": "DiagnosticToolCall",
      "type": "object"
    },
    "InteractionTraceSummary": {
      "properties": {
        "generation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation Id"
        },
        "generation_state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generation State"
        },
        "interaction_id": {
          "format": "uuid",
          "title": "Interaction Id",
          "type": "string"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "trigger": {
          "enum": [
            "user",
            "proactive",
            "ignored_voice",
            "proactive_deferred"
          ],
          "title": "Trigger",
          "type": "string"
        },
        "turn_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Turn Id"
        }
      },
      "required": [
        "interaction_id",
        "session_id",
        "occurred_at",
        "trigger"
      ],
      "title": "InteractionTraceSummary",
      "type": "object"
    },
    "NonsecretModelRoute": {
      "properties": {
        "context_window": {
          "default": 8192,
          "maximum": 2000000,
          "minimum": 1024,
          "title": "Context Window",
          "type": "integer"
        },
        "endpoint_digest": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint Digest"
        },
        "model": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Model",
          "type": "string"
        },
        "provider": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "role": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role",
        "provider",
        "model"
      ],
      "title": "NonsecretModelRoute",
      "type": "object"
    },
    "PromptBudgetReport": {
      "properties": {
        "budget": {
          "minimum": 1,
          "title": "Budget",
          "type": "integer"
        },
        "conversation_tokens": {
          "minimum": 0,
          "title": "Conversation Tokens",
          "type": "integer"
        },
        "dropped_history_turns": {
          "minimum": 0,
          "title": "Dropped History Turns",
          "type": "integer"
        },
        "memory_tokens": {
          "minimum": 0,
          "title": "Memory Tokens",
          "type": "integer"
        },
        "model_role": {
          "enum": [
            "chat",
            "memory_extraction",
            "memory_summary",
            "embedding"
          ],
          "title": "Model Role",
          "type": "string"
        },
        "persona_tokens": {
          "minimum": 0,
          "title": "Persona Tokens",
          "type": "integer"
        },
        "relationship_tokens": {
          "minimum": 0,
          "title": "Relationship Tokens",
          "type": "integer"
        },
        "safety_tokens": {
          "minimum": 0,
          "title": "Safety Tokens",
          "type": "integer"
        },
        "scene_tokens": {
          "minimum": 0,
          "title": "Scene Tokens",
          "type": "integer"
        },
        "state_tokens": {
          "minimum": 0,
          "title": "State Tokens",
          "type": "integer"
        },
        "used": {
          "minimum": 0,
          "title": "Used",
          "type": "integer"
        }
      },
      "required": [
        "model_role",
        "budget",
        "used",
        "safety_tokens",
        "persona_tokens",
        "state_tokens",
        "relationship_tokens",
        "memory_tokens",
        "scene_tokens",
        "conversation_tokens",
        "dropped_history_turns"
      ],
      "title": "PromptBudgetReport",
      "type": "object"
    },
    "PromptContextIdentity": {
      "properties": {
        "character_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Character Id",
          "type": "string"
        },
        "character_package_hash": {
          "maxLength": 64,
          "minLength": 16,
          "title": "Character Package Hash",
          "type": "string"
        },
        "chat_route": {
          "$ref": "#/$defs/NonsecretModelRoute"
        },
        "identity_hash": {
          "maxLength": 64,
          "minLength": 16,
          "title": "Identity Hash",
          "type": "string"
        },
        "memory_summary_route": {
          "$ref": "#/$defs/NonsecretModelRoute"
        },
        "presentation_profile": {
          "default": "default",
          "maxLength": 64,
          "title": "Presentation Profile",
          "type": "string"
        },
        "prompt_template_version": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Prompt Template Version",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "tools_digest": {
          "maxLength": 64,
          "minLength": 16,
          "title": "Tools Digest",
          "type": "string"
        }
      },
      "required": [
        "identity_hash",
        "character_id",
        "character_package_hash",
        "prompt_template_version",
        "chat_route",
        "memory_summary_route",
        "tools_digest"
      ],
      "title": "PromptContextIdentity",
      "type": "object"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/interaction-trace-detail.schema.json",
  "properties": {
    "delivery_parts": {
      "items": {
        "$ref": "#/$defs/DiagnosticDeliveryPart"
      },
      "title": "Delivery Parts",
      "type": "array"
    },
    "delivery_status": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Delivery Status"
    },
    "memory_candidates": {
      "items": {
        "$ref": "#/$defs/DiagnosticMemoryReference"
      },
      "title": "Memory Candidates",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "playback_segments": {
      "items": {
        "$ref": "#/$defs/DiagnosticPlaybackSegment"
      },
      "title": "Playback Segments",
      "type": "array"
    },
    "prompt_budget": {
      "anyOf": [
        {
          "$ref": "#/$defs/PromptBudgetReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "prompt_identity": {
      "anyOf": [
        {
          "$ref": "#/$defs/PromptContextIdentity"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "response_plan": {
      "anyOf": [
        {
          "$ref": "#/$defs/DiagnosticResponsePlan"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "selected_memory_ids": {
      "anyOf": [
        {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Selected Memory Ids"
    },
    "summary": {
      "$ref": "#/$defs/InteractionTraceSummary"
    },
    "timeline": {
      "items": {
        "$ref": "#/$defs/DiagnosticTimelineItem"
      },
      "maxItems": 200,
      "title": "Timeline",
      "type": "array"
    },
    "tool_calls": {
      "items": {
        "$ref": "#/$defs/DiagnosticToolCall"
      },
      "title": "Tool Calls",
      "type": "array"
    },
    "truncated": {
      "default": false,
      "title": "Truncated",
      "type": "boolean"
    }
  },
  "required": [
    "summary"
  ],
  "title": "InteractionTraceDetail",
  "type": "object",
  "x-schema-version": "1.0"
}
