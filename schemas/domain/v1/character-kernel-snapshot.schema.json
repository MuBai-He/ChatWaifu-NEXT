{
  "$defs": {
    "AffectState": {
      "properties": {
        "arousal": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Arousal",
          "type": "number"
        },
        "attention": {
          "default": 0.7,
          "maximum": 1,
          "minimum": 0,
          "title": "Attention",
          "type": "number"
        },
        "embarrassment": {
          "default": 0.1,
          "maximum": 1,
          "minimum": 0,
          "title": "Embarrassment",
          "type": "number"
        },
        "energy": {
          "default": 0.65,
          "maximum": 1,
          "minimum": 0,
          "title": "Energy",
          "type": "number"
        },
        "tension": {
          "default": 0.05,
          "maximum": 1,
          "minimum": 0,
          "title": "Tension",
          "type": "number"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        },
        "valence": {
          "default": 0.15,
          "maximum": 1,
          "minimum": -1,
          "title": "Valence",
          "type": "number"
        }
      },
      "required": [
        "updated_at"
      ],
      "title": "AffectState",
      "type": "object"
    },
    "RelationshipState": {
      "properties": {
        "affinity": {
          "default": 0.25,
          "maximum": 1,
          "minimum": 0,
          "title": "Affinity",
          "type": "number"
        },
        "comfort": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Comfort",
          "type": "number"
        },
        "familiarity": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Familiarity",
          "type": "number"
        },
        "interaction_count": {
          "default": 0,
          "minimum": 0,
          "title": "Interaction Count",
          "type": "integer"
        },
        "preferred_address": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Address"
        },
        "recent_tension": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Recent Tension",
          "type": "number"
        },
        "stage": {
          "default": "acquaintance",
          "enum": [
            "acquaintance",
            "familiar",
            "trusted",
            "close"
          ],
          "title": "Stage",
          "type": "string"
        },
        "trust": {
          "default": 0.2,
          "maximum": 1,
          "minimum": 0,
          "title": "Trust",
          "type": "number"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "updated_at"
      ],
      "title": "RelationshipState",
      "type": "object"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/character-kernel-snapshot.schema.json",
  "properties": {
    "affect": {
      "$ref": "#/$defs/AffectState"
    },
    "character_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Character Id",
      "type": "string"
    },
    "relationship": {
      "$ref": "#/$defs/RelationshipState"
    },
    "revision": {
      "minimum": 0,
      "title": "Revision",
      "type": "integer"
    },
    "user_scope": {
      "maxLength": 128,
      "minLength": 1,
      "title": "User Scope",
      "type": "string"
    }
  },
  "required": [
    "character_id",
    "user_scope",
    "revision",
    "affect",
    "relationship"
  ],
  "title": "CharacterKernelSnapshot",
  "type": "object",
  "x-schema-version": "1.0"
}
