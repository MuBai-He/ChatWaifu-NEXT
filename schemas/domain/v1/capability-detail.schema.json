{
  "$defs": {
    "CapabilityDescriptor": {
      "properties": {
        "availability_reason": {
          "anyOf": [
            {
              "maxLength": 400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Availability Reason"
        },
        "capability_id": {
          "title": "Capability Id",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "confirmation_required": {
          "default": false,
          "title": "Confirmation Required",
          "type": "boolean"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "execution_location": {
          "default": "runtime",
          "enum": [
            "runtime",
            "paired_device",
            "plugin"
          ],
          "title": "Execution Location",
          "type": "string"
        },
        "fingerprint": {
          "title": "Fingerprint",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "required_permissions": {
          "items": {
            "type": "string"
          },
          "title": "Required Permissions",
          "type": "array"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "side_effect": {
          "$ref": "#/$defs/SideEffect"
        },
        "skill_id": {
          "title": "Skill Id",
          "type": "string"
        },
        "skill_version": {
          "title": "Skill Version",
          "type": "string"
        },
        "source": {
          "enum": [
            "builtin",
            "plugin",
            "mcp_connection"
          ],
          "title": "Source",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/CapabilityStatus"
        }
      },
      "required": [
        "capability_id",
        "skill_id",
        "skill_version",
        "name",
        "description",
        "category",
        "source",
        "status",
        "side_effect",
        "fingerprint"
      ],
      "title": "CapabilityDescriptor",
      "type": "object"
    },
    "CapabilityStatus": {
      "enum": [
        "available",
        "authorization_required",
        "disabled",
        "not_configured",
        "adapter_required",
        "unsupported"
      ],
      "title": "CapabilityStatus",
      "type": "string"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "SideEffect": {
      "enum": [
        "read",
        "write",
        "destructive",
        "external_communication",
        "device_control"
      ],
      "title": "SideEffect",
      "type": "string"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/capability-detail.schema.json",
  "properties": {
    "descriptor": {
      "$ref": "#/$defs/CapabilityDescriptor"
    },
    "input_schema": {
      "$ref": "#/$defs/JsonObject"
    },
    "instructions": {
      "title": "Instructions",
      "type": "string"
    },
    "output_schema": {
      "$ref": "#/$defs/JsonObject"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "descriptor",
    "input_schema",
    "output_schema",
    "instructions"
  ],
  "title": "CapabilityDetail",
  "type": "object",
  "x-schema-version": "1.0"
}
