{
  "$id": "https://chatwaifu.local/schemas/domain/v1/plugin-snapshot.schema.json",
  "properties": {
    "description": {
      "title": "Description",
      "type": "string"
    },
    "enabled": {
      "title": "Enabled",
      "type": "boolean"
    },
    "install_path": {
      "title": "Install Path",
      "type": "string"
    },
    "installed_at": {
      "format": "date-time",
      "title": "Installed At",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "network_policy": {
      "default": "deny",
      "enum": [
        "deny",
        "loopback",
        "allow"
      ],
      "title": "Network Policy",
      "type": "string"
    },
    "plugin_id": {
      "title": "Plugin Id",
      "type": "string"
    },
    "sandbox_backend": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sandbox Backend"
    },
    "sandbox_limits_enforced": {
      "items": {
        "type": "string"
      },
      "title": "Sandbox Limits Enforced",
      "type": "array"
    },
    "sandbox_mode": {
      "default": "required",
      "enum": [
        "required",
        "preferred",
        "disabled"
      ],
      "title": "Sandbox Mode",
      "type": "string"
    },
    "trust_level": {
      "default": "untrusted",
      "enum": [
        "trusted",
        "untrusted"
      ],
      "title": "Trust Level",
      "type": "string"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "plugin_id",
    "version",
    "name",
    "description",
    "enabled",
    "install_path",
    "installed_at",
    "updated_at"
  ],
  "title": "PluginSnapshot",
  "type": "object",
  "x-schema-version": "1.0"
}
