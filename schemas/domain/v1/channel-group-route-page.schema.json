{
  "$defs": {
    "ChannelGroupPauseReason": {
      "enum": [
        "operator_disabled",
        "reconnect",
        "membership_changed",
        "account_changed",
        "connection_disabled",
        "connection_deleted",
        "configuration_changed",
        "link_revoked",
        "scene_reset",
        "route_deleted"
      ],
      "title": "ChannelGroupPauseReason",
      "type": "string"
    },
    "ChannelGroupRouteMemberSnapshot": {
      "properties": {
        "can_speak": {
          "title": "Can Speak",
          "type": "boolean"
        },
        "link_id": {
          "format": "uuid",
          "title": "Link Id",
          "type": "string"
        },
        "participant_id": {
          "title": "Participant Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sender_key": {
          "title": "Sender Key",
          "type": "string"
        }
      },
      "required": [
        "link_id",
        "sender_key",
        "participant_id",
        "can_speak"
      ],
      "title": "ChannelGroupRouteMemberSnapshot",
      "type": "object"
    },
    "ChannelGroupRouteSnapshot": {
      "properties": {
        "account_key": {
          "title": "Account Key",
          "type": "string"
        },
        "allow_requested_voice": {
          "default": false,
          "title": "Allow Requested Voice",
          "type": "boolean"
        },
        "audience_fingerprint": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Audience Fingerprint",
          "type": "string"
        },
        "character_id": {
          "title": "Character Id",
          "type": "string"
        },
        "connection_id": {
          "format": "uuid",
          "title": "Connection Id",
          "type": "string"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "deleted_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Deleted At"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "group_id": {
          "title": "Group Id",
          "type": "string"
        },
        "members": {
          "items": {
            "$ref": "#/$defs/ChannelGroupRouteMemberSnapshot"
          },
          "maxItems": 2000,
          "minItems": 2,
          "title": "Members",
          "type": "array"
        },
        "observation_id": {
          "format": "uuid",
          "title": "Observation Id",
          "type": "string"
        },
        "pause_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChannelGroupPauseReason"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "revision": {
          "minimum": 1,
          "title": "Revision",
          "type": "integer"
        },
        "route_id": {
          "format": "uuid",
          "title": "Route Id",
          "type": "string"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "route_id",
        "connection_id",
        "account_key",
        "group_id",
        "character_id",
        "scene_id",
        "display_name",
        "revision",
        "observation_id",
        "audience_fingerprint",
        "members",
        "created_at",
        "updated_at"
      ],
      "title": "ChannelGroupRouteSnapshot",
      "type": "object"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/channel-group-route-page.schema.json",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ChannelGroupRouteSnapshot"
      },
      "maxItems": 50,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "ChannelGroupRoutePage",
  "type": "object",
  "x-schema-version": "1.0"
}
