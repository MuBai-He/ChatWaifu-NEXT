      "additionalProperties": {
        "type": "integer"
      },
      "title": "Observation States",
      "type": "object"
    },
    "processing_room_states": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Processing Room States",
      "type": "object"
    },
    "processor": {
      "$ref": "#/$defs/JsonObject"
    },
    "review_decisions": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Review Decisions",
      "type": "object"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
