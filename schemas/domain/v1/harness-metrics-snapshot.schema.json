      "additionalProperties": {
        "type": "integer"
      },
      "title": "Active Alerts",
      "type": "object"
    },
    "duplicate_action_claims": {
      "default": null,
      "title": "Duplicate Action Claims",
      "type": "null"
    },
    "generated_at": {
      "minimum": 0,
      "title": "Generated At",
      "type": "integer"
    },
    "latency_seconds": {
