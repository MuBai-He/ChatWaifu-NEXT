{
  "$id": "https://chatwaifu.local/schemas/domain/v1/prompt-budget-report.schema.json",
  "properties": {
    "budget": {
      "minimum": 1,
      "title": "Budget",
      "type": "integer"
    },
    "conversation_tokens": {
      "minimum": 0,
      "title": "Conversation Tokens",
      "type": "integer"
    },
    "dropped_history_turns": {
      "minimum": 0,
      "title": "Dropped History Turns",
      "type": "integer"
    },
    "estimate_margin_ratio": {
      "default": 0,
      "maximum": 1,
      "minimum": 0,
      "title": "Estimate Margin Ratio",
      "type": "number"
    },
    "estimator": {
      "const": "character_half_v1",
      "default": "character_half_v1",
      "title": "Estimator",
      "type": "string"
    },
    "memory_tokens": {
      "minimum": 0,
      "title": "Memory Tokens",
      "type": "integer"
    },
    "model_role": {
      "enum": [
        "chat",
        "memory_extraction",
        "memory_summary",
        "embedding"
      ],
      "title": "Model Role",
      "type": "string"
    },
    "omitted_memory_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Omitted Memory Ids",
      "type": "array"
    },
    "output_reserve_tokens": {
      "default": 900,
      "minimum": 0,
      "title": "Output Reserve Tokens",
      "type": "integer"
    },
    "persona_omitted_characters": {
      "default": 0,
      "minimum": 0,
      "title": "Persona Omitted Characters",
      "type": "integer"
    },
    "persona_tokens": {
      "minimum": 0,
      "title": "Persona Tokens",
      "type": "integer"
    },
    "photo_omitted_characters": {
      "default": 0,
      "minimum": 0,
      "title": "Photo Omitted Characters",
      "type": "integer"
    },
    "relationship_tokens": {
      "minimum": 0,
      "title": "Relationship Tokens",
      "type": "integer"
    },
    "safety_tokens": {
      "minimum": 0,
      "title": "Safety Tokens",
      "type": "integer"
    },
    "scene_tokens": {
      "minimum": 0,
      "title": "Scene Tokens",
      "type": "integer"
    },
    "section_budget_limits": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Section Budget Limits",
      "type": "object"
    },
    "state_tokens": {
      "minimum": 0,
      "title": "State Tokens",
      "type": "integer"
    },
    "summary_omitted_characters": {
      "default": 0,
      "minimum": 0,
      "title": "Summary Omitted Characters",
      "type": "integer"
    },
    "used": {
      "minimum": 0,
      "title": "Used",
      "type": "integer"
    }
  },
  "required": [
    "model_role",
    "budget",
    "used",
    "safety_tokens",
    "persona_tokens",
    "state_tokens",
    "relationship_tokens",
    "memory_tokens",
    "scene_tokens",
    "conversation_tokens",
    "dropped_history_turns"
  ],
  "title": "PromptBudgetReport",
  "type": "object",
  "x-schema-version": "1.0"
}
