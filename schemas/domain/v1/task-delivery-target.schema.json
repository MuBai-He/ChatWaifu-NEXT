{
  "$defs": {
    "TaskChannelBinding": {
      "description": "Runtime-issued channel authority, never accepted from a model or task-create API.",
      "properties": {
        "account_key": {
          "title": "Account Key",
          "type": "string"
        },
        "audience_fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Audience Fingerprint"
        },
        "connection_id": {
          "format": "uuid",
          "title": "Connection Id",
          "type": "string"
        },
        "conversation_key": {
          "title": "Conversation Key",
          "type": "string"
        },
        "link_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link Id"
        },
        "link_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Link Revision"
        },
        "policy_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Revision"
        },
        "route_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Id"
        },
        "route_revision": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Revision"
        },
        "scene_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Scene Id"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sender_key": {
          "title": "Sender Key",
          "type": "string"
        },
        "source_ref": {
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "connection_id",
        "account_key",
        "conversation_key",
        "sender_key",
        "source_ref"
      ],
      "title": "TaskChannelBinding",
      "type": "object"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/task-delivery-target.schema.json",
  "properties": {
    "binding": {
      "$ref": "#/$defs/TaskChannelBinding"
    },
    "generation_id": {
      "format": "uuid",
      "title": "Generation Id",
      "type": "string"
    },
    "purpose": {
      "default": "file",
      "enum": [
        "file",
        "result"
      ],
      "title": "Purpose",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "format": "uuid",
      "title": "Session Id",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "turn_id": {
      "format": "uuid",
      "title": "Turn Id",
      "type": "string"
    }
  },
  "required": [
    "request_id",
    "task_id",
    "session_id",
    "turn_id",
    "generation_id",
    "binding"
  ],
  "title": "TaskDeliveryTarget",
  "type": "object",
  "x-schema-version": "1.0"
}
