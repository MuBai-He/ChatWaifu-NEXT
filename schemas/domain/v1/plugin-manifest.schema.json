{
  "$defs": {
    "PluginTransport": {
      "properties": {
        "command": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Command",
          "type": "array"
        },
        "kind": {
          "const": "stdio",
          "default": "stdio",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "command"
      ],
      "title": "PluginTransport",
      "type": "object"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/plugin-manifest.schema.json",
  "properties": {
    "description": {
      "maxLength": 2000,
      "minLength": 1,
      "title": "Description",
      "type": "string"
    },
    "name": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "plugin_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
      "title": "Plugin Id",
      "type": "string"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "skills": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Skills",
      "type": "array"
    },
    "transport": {
      "$ref": "#/$defs/PluginTransport"
    },
    "version": {
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$",
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "plugin_id",
    "version",
    "name",
    "description",
    "transport",
    "skills"
  ],
  "title": "PluginManifest",
  "type": "object",
  "x-schema-version": "1.0"
}
