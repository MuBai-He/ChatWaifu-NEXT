{
  "$defs": {
    "ChannelChatType": {
      "description": "Conversation shapes understood by this schema major.",
      "enum": [
        "direct",
        "group"
      ],
      "title": "ChannelChatType",
      "type": "string"
    },
    "ChannelDeliveryStatus": {
      "enum": [
        "pending",
        "sending",
        "delivered",
        "failed",
        "cancelled"
      ],
      "title": "ChannelDeliveryStatus",
      "type": "string"
    },
    "ChannelGroupTurnSnapshot": {
      "properties": {
        "cancelable": {
          "default": false,
          "title": "Cancelable",
          "type": "boolean"
        },
        "participant_id": {
          "title": "Participant Id",
          "type": "string"
        },
        "provider_receipt_present": {
          "default": false,
          "title": "Provider Receipt Present",
          "type": "boolean"
        },
        "route_id": {
          "format": "uuid",
          "title": "Route Id",
          "type": "string"
        },
        "route_revision": {
          "minimum": 1,
          "title": "Route Revision",
          "type": "integer"
        },
        "scene_id": {
          "title": "Scene Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "turn": {
          "$ref": "#/$defs/ChannelTurnSnapshot"
        }
      },
      "required": [
        "route_id",
        "route_revision",
        "scene_id",
        "participant_id",
        "turn"
      ],
      "title": "ChannelGroupTurnSnapshot",
      "type": "object"
    },
    "ChannelTurnSnapshot": {
      "description": "Current durable result for one normalized inbound message.",
      "properties": {
        "account_key": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Key"
        },
        "channel_turn_id": {
          "format": "uuid",
          "title": "Channel Turn Id",
          "type": "string"
        },
        "chat_type": {
          "$ref": "#/$defs/ChannelChatType",
          "default": "direct"
        },
        "completed_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completed At"
        },
        "connection_id": {
          "format": "uuid",
          "title": "Connection Id",
          "type": "string"
        },
        "conversation_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Conversation Key",
          "type": "string"
        },
        "conversation_label": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Untrusted display label only",
          "title": "Conversation Label"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "delivery_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Delivery Id"
        },
        "delivery_status": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChannelDeliveryStatus"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/StructuredError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "external_message_id": {
          "maxLength": 512,
          "minLength": 1,
          "title": "External Message Id",
          "type": "string"
        },
        "generation_id": {
          "format": "uuid",
          "title": "Generation Id",
          "type": "string"
        },
        "principal_scope": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Principal Scope",
          "type": "string"
        },
        "reply_text": {
          "anyOf": [
            {
              "maxLength": 100000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reply Text"
        },
        "revision": {
          "minimum": 0,
          "title": "Revision",
          "type": "integer"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sender_display_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Untrusted display label only",
          "title": "Sender Display Name"
        },
        "sender_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Sender Key",
          "type": "string"
        },
        "session_id": {
          "format": "uuid",
          "title": "Session Id",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ChannelTurnStatus"
        },
        "turn_id": {
          "format": "uuid",
          "title": "Turn Id",
          "type": "string"
        },
        "updated_at": {
          "format": "date-time",
          "title": "Updated At",
          "type": "string"
        }
      },
      "required": [
        "channel_turn_id",
        "connection_id",
        "external_message_id",
        "conversation_key",
        "sender_key",
        "principal_scope",
        "session_id",
        "turn_id",
        "generation_id",
        "status",
        "revision",
        "created_at",
        "updated_at"
      ],
      "title": "ChannelTurnSnapshot",
      "type": "object"
    },
    "ChannelTurnStatus": {
      "enum": [
        "accepted",
        "processing",
        "completed",
        "cancelling",
        "cancelled",
        "failed",
        "timed_out"
      ],
      "title": "ChannelTurnStatus",
      "type": "string"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "StructuredError": {
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "component"
      ],
      "title": "StructuredError",
      "type": "object"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/channel-group-turn-page.schema.json",
  "properties": {
    "items": {
      "items": {
        "$ref": "#/$defs/ChannelGroupTurnSnapshot"
      },
      "maxItems": 50,
      "title": "Items",
      "type": "array"
    },
    "next_cursor": {
      "anyOf": [
        {
          "maxLength": 256,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Next Cursor"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    }
  },
  "title": "ChannelGroupTurnPage",
  "type": "object",
  "x-schema-version": "1.0"
}
