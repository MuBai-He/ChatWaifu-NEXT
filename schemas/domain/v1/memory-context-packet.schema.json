{
  "$defs": {
    "MemoryChannelAttribution": {
      "description": "Immutable, provider-neutral attribution for one memory source.\n\nStable provider-scoped keys preserve where an observation came from after\nthe originating transcript falls out of the recent-history window. Display\nlabels are optional untrusted presentation data and never identity or\ninstructions.",
      "properties": {
        "account_key": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Account Key"
        },
        "chat_type": {
          "enum": [
            "direct",
            "group"
          ],
          "title": "Chat Type",
          "type": "string"
        },
        "connection_id": {
          "format": "uuid",
          "title": "Connection Id",
          "type": "string"
        },
        "conversation_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Conversation Key",
          "type": "string"
        },
        "conversation_label": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Label"
        },
        "principal_scope": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Principal Scope",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "received_at": {
          "format": "date-time",
          "title": "Received At",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "sender_display_name": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sender Display Name"
        },
        "sender_key": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Sender Key",
          "type": "string"
        }
      },
      "required": [
        "provider_id",
        "connection_id",
        "principal_scope",
        "chat_type",
        "conversation_key",
        "sender_key",
        "received_at"
      ],
      "title": "MemoryChannelAttribution",
      "type": "object"
    },
    "MemoryExcerpt": {
      "properties": {
        "channel_attributions": {
          "items": {
            "$ref": "#/$defs/MemoryChannelAttribution"
          },
          "title": "Channel Attributions",
          "type": "array"
        },
        "entity_relevance": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Entity Relevance",
          "type": "number"
        },
        "lexical_relevance": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Lexical Relevance",
          "type": "number"
        },
        "memory_id": {
          "format": "uuid",
          "title": "Memory Id",
          "type": "string"
        },
        "relevance": {
          "maximum": 1,
          "minimum": 0,
          "title": "Relevance",
          "type": "number"
        },
        "retrieval_sources": {
          "items": {
            "$ref": "#/$defs/MemoryRetrievalSource"
          },
          "title": "Retrieval Sources",
          "type": "array"
        },
        "semantic_relevance": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Semantic Relevance",
          "type": "number"
        },
        "source_event_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Event Ids",
          "type": "array"
        },
        "temporal_relevance": {
          "default": 0,
          "maximum": 1,
          "minimum": 0,
          "title": "Temporal Relevance",
          "type": "number"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "memory_id",
        "text",
        "source_event_ids",
        "relevance"
      ],
      "title": "MemoryExcerpt",
      "type": "object"
    },
    "MemoryRetrievalSource": {
      "enum": [
        "pinned",
        "fts",
        "semantic",
        "temporal",
        "recent"
      ],
      "type": "string"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/memory-context-packet.schema.json",
  "properties": {
    "open_commitments": {
      "items": {
        "$ref": "#/$defs/MemoryExcerpt"
      },
      "title": "Open Commitments",
      "type": "array"
    },
    "pinned_facts": {
      "items": {
        "$ref": "#/$defs/MemoryExcerpt"
      },
      "title": "Pinned Facts",
      "type": "array"
    },
    "provenance_ids": {
      "items": {
        "format": "uuid",
        "type": "string"
      },
      "title": "Provenance Ids",
      "type": "array"
    },
    "recent_episodes": {
      "items": {
        "$ref": "#/$defs/MemoryExcerpt"
      },
      "title": "Recent Episodes",
      "type": "array"
    },
    "relationship_context": {
      "items": {
        "$ref": "#/$defs/MemoryExcerpt"
      },
      "title": "Relationship Context",
      "type": "array"
    },
    "relevant_memories": {
      "items": {
        "$ref": "#/$defs/MemoryExcerpt"
      },
      "title": "Relevant Memories",
      "type": "array"
    },
    "token_budget_used": {
      "minimum": 0,
      "title": "Token Budget Used",
      "type": "integer"
    }
  },
  "required": [
    "token_budget_used"
  ],
  "title": "MemoryContextPacket",
  "type": "object",
  "x-schema-version": "1.0"
}
