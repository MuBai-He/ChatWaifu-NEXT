      "type": "string"
    },
    "ChannelDeliveryStatus": {
      "enum": [
        "pending",
        "sending",
        "delivered",
        "failed",
        "cancelled"
      ],
      "title": "ChannelDeliveryStatus",
      "type": "string"
    },
    "ChannelTextDeliveryPartPayload": {
      "properties": {
        "kind": {
          "const": "text",
