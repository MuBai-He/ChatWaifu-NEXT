{
  "$defs": {
    "ChannelAuthorizationMethod": {
      "description": "Interactive authorization methods exposed to trusted local clients.",
      "enum": [
        "qr_code"
      ],
      "title": "ChannelAuthorizationMethod",
      "type": "string"
    },
    "ChannelChatType": {
      "description": "Conversation shapes understood by this schema major.",
      "enum": [
        "direct",
        "group"
      ],
      "title": "ChannelChatType",
      "type": "string"
    },
    "ChannelConnectionConfiguration": {
      "description": "Non-secret Runtime configuration for one external channel account.\n\n``principal_scope`` is the Runtime-owned privacy, relationship, and memory\nisolation key. It is not a provider user id and must never be derived from\nmessage text. Provider credentials and login state are intentionally absent.",
      "properties": {
        "account_key": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Opaque provider-scoped account identity; never a credential",
          "title": "Account Key"
        },
        "allowed_sender_keys": {
          "description": "Opaque provider-scoped sender identities admitted by this connection; an empty list admits no senders",
          "items": {
            "maxLength": 512,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 64,
          "title": "Allowed Sender Keys",
          "type": "array"
        },
        "character_id": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Character Id",
          "type": "string"
        },
        "connection_id": {
          "format": "uuid",
          "title": "Connection Id",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "name": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "principal_scope": {
          "description": "Runtime-owned stable isolation key for persona relationship and memory state; it is not a provider identity and must match the configured connection",
          "maxLength": 256,
          "minLength": 1,
          "title": "Principal Scope",
          "type": "string"
        },
        "provider_id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{1,127}$",
          "title": "Provider Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "timeout_seconds": {
          "default": 120,
          "description": "Recent authenticated adapter activity window used by local health presentation; it is not a generation or provider-delivery deadline",
          "exclusiveMinimum": 0,
          "maximum": 600,
          "title": "Timeout Seconds",
          "type": "number"
        }
      },
      "required": [
        "connection_id",
        "provider_id",
        "name",
        "character_id",
        "principal_scope"
      ],
      "title": "ChannelConnectionConfiguration",
      "type": "object"
    },
    "ChannelConnectionStatus": {
      "enum": [
        "untested",
        "ready",
        "degraded",
        "error",
        "disabled"
      ],
      "title": "ChannelConnectionStatus",
      "type": "string"
    },
    "ChannelMessageKind": {
      "description": "Message payload kinds understood by this schema major.",
      "enum": [
        "text"
      ],
      "title": "ChannelMessageKind",
      "type": "string"
    },
    "ChannelProviderCapabilities": {
      "description": "Transport behavior advertised by one provider adapter.\n\nThe first provider advertises only direct text by default. ``group`` is a\nprotocol capability for future adapters, but a Runtime must reject it until\nits provider registration and local policy explicitly enable group chat.",
      "properties": {
        "authorization_methods": {
          "description": "Interactive authorization methods implemented by the local adapter; an empty list means connection provisioning is external",
          "items": {
            "$ref": "#/$defs/ChannelAuthorizationMethod"
          },
          "maxItems": 8,
          "title": "Authorization Methods",
          "type": "array"
        },
        "chat_types": {
          "items": {
            "$ref": "#/$defs/ChannelChatType"
          },
          "minItems": 1,
          "title": "Chat Types",
          "type": "array"
        },
        "inbound_message_kinds": {
          "items": {
            "$ref": "#/$defs/ChannelMessageKind"
          },
          "minItems": 1,
          "title": "Inbound Message Kinds",
          "type": "array"
        },
        "max_text_chars": {
          "default": 20000,
          "maximum": 1000000,
          "minimum": 1,
          "title": "Max Text Chars",
          "type": "integer"
        },
        "outbound_message_kinds": {
          "items": {
            "$ref": "#/$defs/ChannelMessageKind"
          },
          "minItems": 1,
          "title": "Outbound Message Kinds",
          "type": "array"
        },
        "supports_cancellation": {
          "default": true,
          "title": "Supports Cancellation",
          "type": "boolean"
        },
        "supports_delivery_ack": {
          "default": true,
          "title": "Supports Delivery Ack",
          "type": "boolean"
        },
        "supports_partial_replies": {
          "default": false,
          "title": "Supports Partial Replies",
          "type": "boolean"
        },
        "supports_proactive_messages": {
          "default": false,
          "title": "Supports Proactive Messages",
          "type": "boolean"
        },
        "supports_typing": {
          "default": false,
          "title": "Supports Typing",
          "type": "boolean"
        }
      },
      "title": "ChannelProviderCapabilities",
      "type": "object"
    },
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "StructuredError": {
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "component": {
          "minLength": 1,
          "title": "Component",
          "type": "string"
        },
        "correlation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Correlation Id"
        },
        "details": {
          "$ref": "#/$defs/JsonObject"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "title": "Retryable",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "retryable",
        "component"
      ],
      "title": "StructuredError",
      "type": "object"
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/channel-connection-snapshot.schema.json",
  "description": "Persisted connection state safe to expose to local settings clients.\n\n``account_key`` and ``allowed_sender_keys`` remain local, non-secret,\nprovider-scoped identifiers. They are never credentials and should not be\nforwarded to a conversation peer.",
  "properties": {
    "capabilities": {
      "$ref": "#/$defs/ChannelProviderCapabilities"
    },
    "configuration": {
      "$ref": "#/$defs/ChannelConnectionConfiguration"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "last_error": {
      "anyOf": [
        {
          "$ref": "#/$defs/StructuredError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "last_seen_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Seen At"
    },
    "revision": {
      "minimum": 1,
      "title": "Revision",
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/ChannelConnectionStatus",
      "default": "untested"
    },
    "updated_at": {
      "format": "date-time",
      "title": "Updated At",
      "type": "string"
    }
  },
  "required": [
    "configuration",
    "revision",
    "created_at",
    "updated_at"
  ],
  "title": "ChannelConnectionSnapshot",
  "type": "object",
  "x-schema-version": "1.0"
}
