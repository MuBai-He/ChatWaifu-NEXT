{
  "$defs": {
    "JsonObject": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "type": "object"
    },
    "JsonValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$id": "https://chatwaifu.local/schemas/domain/v1/avatar-cue.schema.json",
  "properties": {
    "cue_id": {
      "format": "uuid",
      "title": "Cue Id",
      "type": "string"
    },
    "duration_ms": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Duration Ms"
    },
    "generation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Id"
    },
    "intensity": {
      "default": 1.0,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Intensity",
      "type": "number"
    },
    "interruptible": {
      "default": true,
      "title": "Interruptible",
      "type": "boolean"
    },
    "kind": {
      "enum": [
        "state",
        "expression",
        "motion",
        "gaze",
        "speech",
        "override"
      ],
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/JsonObject"
    },
    "name": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "priority": {
      "default": 50,
      "maximum": 100,
      "minimum": 0,
      "title": "Priority",
      "type": "integer"
    },
    "start_anchor": {
      "default": "immediate",
      "title": "Start Anchor",
      "type": "string"
    }
  },
  "required": [
    "cue_id",
    "kind",
    "name"
  ],
  "title": "AvatarCue",
  "type": "object",
  "x-schema-version": "1.0"
}
