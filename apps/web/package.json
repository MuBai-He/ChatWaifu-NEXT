{
  "name": "@chatwaifu/web",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode web",
    "dev:web": "vite --mode web",
    "dev:desktop": "vite --mode desktop",
    "build": "pnpm run build:web",
    "build:web": "tsc -b && vite build --mode web",
    "build:desktop": "tsc -b && vite build --mode desktop",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "pnpm run test:e2e:web && pnpm run test:e2e:desktop",
    "test:e2e:web": "playwright test --config playwright.config.ts",
    "test:e2e:desktop": "playwright test --config playwright.desktop.config.ts",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --mode web",
    "preview:web": "vite preview --mode web",
    "preview:desktop": "vite preview --mode desktop"
  },
  "dependencies": {
    "@chatwaifu/avatar-sdk": "workspace:*",
    "@chatwaifu/protocol": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.37.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.0.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.57.1",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  }
}
