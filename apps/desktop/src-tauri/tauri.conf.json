{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ChatWaifu NEXT",
  "version": "0.2.0",
  "identifier": "local.chatwaifu.next",
  "build": {
    "beforeBuildCommand": "uv run python ../../tools/run_pnpm.py --filter @chatwaifu/web build:desktop",
    "beforeDevCommand": "uv run python ../../tools/run_pnpm.py --filter @chatwaifu/web exec vite --mode desktop --host 127.0.0.1 --port 5173 --strictPort",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../../web/dist/desktop"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "avatar-overlay",
        "title": "绫地宁宁",
        "url": "/desktop-pet",
        "width": 430,
        "height": 650,
        "minWidth": 320,
        "minHeight": 480,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "acceptFirstMouse": true,
        "backgroundThrottling": "disabled",
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": true,
        "maximizable": false,
        "fullscreen": false,
        "visible": true
      }
    ],
    "security": {
      "capabilities": ["desktop-pet"],
      "csp": "default-src 'self' customprotocol: asset: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' asset: data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
