+        state=SkillRunState.SUCCEEDED,
+        result=SkillResult(
+            status="succeeded", data={"url": "https://source.example/prior", "text": text}
+        ),
+        created_at=now,
+        updated_at=now,
+    )
+    return SourceContextPacket((SourceContextReceipt(run, True),))
+
