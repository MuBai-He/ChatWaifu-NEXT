{"sample_key": "frozen_icao:r0:t2", "source_key": "icao", "prior_replies": ["依据提供的 ICAO 资料，相关规定整理如下：\n\n- 发布日期：正文表述为“今天（Today）”，并在文末标注为 2026 年 3 月 27 日（未单独标注其他发布日期字段）。\n\n- 生效日期：2026 年 3 月 27 日（effective on 27 March 2026）。\n\n- 充电宝数量限制：旅客携带的锂电池充电宝限制为每人最多 2 个（limited to two per passenger）。\n\n- 机上充电限制：明确禁止旅客在飞行途中为充电宝充电（prohibited from recharging them during flights）。\n\n- 适用范围与例外：新规范针对旅客携带的锂电池充电宝，经修订《危险品航空安全运输技术细则》（Doc 9284）补篇后提供给全部 193 个 ICAO 成员国；例外情况为机组人员（crew）可根据航空器的运行要求继续携带和使用这些充电宝。\n  材料未提及充电宝的额定能量（Wh）分档限制、托运携带规则，以及各成员国具体的国内转化生效情况。"], "generation_id": "077a254a-c1f7-4a5c-aa06-39313da5c041", "identity": {"schema_version": "1.0", "identity_hash": "fdb1e45913b7f55ec32480549e57d2d4b1c8d936290c302a1b6dc4fb119401ae", "character_id": "default", "character_package_hash": "9fca992decf57d4e2060aabedd8cc019613c4df67f37ade2f61daf6e4bbf910f", "prompt_template_version": "v13", "presentation_profile": "detailed_answer", "chat_route": {"role": "chat", "provider": "openai_compatible", "model": "gemini-3.8-flash-high", "endpoint_digest": "937c7a5a291b7e56db4b0f98cc3054b5443743de0cb8d3ca60189a15e1686b14", "context_window": 32768, "budget": {"version": "1.0", "input_token_limit": null, "output_token_limit": null, "output_reserve_tokens": 8192, "max_output_tokens": 8192, "estimate_margin_ratio": 0.15, "section_policy": "scaled", "history_turn_limit": 16, "memory_candidate_limit": 12, "tool_result_max_bytes": 131072}}, "memory_summary_route": {"role": "memory_summary", "provider": "demo", "model": "deterministic-summary-v1", "endpoint_digest": null, "context_window": 8192, "budget": {"version": "1.0", "input_token_limit": null, "output_token_limit": null, "output_reserve_tokens": 900, "max_output_tokens": null, "estimate_margin_ratio": 0.0, "section_policy": "legacy", "history_turn_limit": 16, "memory_candidate_limit": 12, "tool_result_max_bytes": 32768}}, "tools_digest": "ce43edd5bd9fc8ad118e0a0224b3c7b5"}, "report": {"model_role": "chat", "budget": 21370, "used": 3284, "safety_toke