+    async def _read_pdf(self, normalized: str) -> tuple[JsonObject, bytes, str]:
+        """Crawl4AI 0.9.3+ pairs this fixed strategy with its PDF crawler.
+
+        The HTML /md path cannot render PDF downloads. The companion service
+        owns parsing, redirect validation and resource limits; Runtime sends no
+        arbitrary strategy, hooks, image paths or provider SDK objects.
+        """
+        payload, body, retrieved_at = await self._json_request(
+            "POST",
+            "/crawl",
+            json_body={
+                "urls": [normalized],
+                "crawler_config": {
+                    "type": "CrawlerRunConfig",
+                    "params": {
+                        "scraping_strategy": {"type": "PDFContentScrapingStrategy", "params": {}},
+                        "cache_mode": {"type": "CacheMode", "params": "bypass"},
+                    },
+                },
+            },
+        )
+        results = payload.get("results")
+        if (
+            payload.get("success") is not True
+            or not isinstance(results, list)
+            or len(results) != 1
+            or not isinstance(results[0], dict)
+        ):
+            raise SkillExecutionError(
+                "web_provider_format_changed", "Crawl4AI returned no single PDF result"
+            )
+        result = results[0]
+        if result.get("success") is not True or result.get("status_code") != 200:
+            raise SkillExecutionError(
+                "web_provider_crawl_failed", "The PDF source could not be extracted"
+            )
+        if result.get("url") != normalized:
+            raise SkillExecutionError(
+                "web_provider_format_changed", "Crawl4AI returned a different PDF source"
+            )
+        markdown = result.get("markdown")
+        if not isinstance(markdown, dict) or not isinstance(markdown.get("raw_markdown"), str):
+            raise SkillExecutionError(
+                "web_provider_format_changed", "Crawl4AI returned no PDF markdown"
+            )
+        return (
+            {"markdown": markdown["raw_markdown"], "metadata": result.get("metadata")},
+            body,
+            retrieved_at,
+        )
+
 
