CHATWAIFU_ENVIRONMENT=development
CHATWAIFU_LOG_LEVEL=INFO
CHATWAIFU_CONFIG_DIR=.local/config
CHATWAIFU_DATA_DIR=.local/data
CHATWAIFU_RUNTIME__HOST=127.0.0.1
CHATWAIFU_RUNTIME__PORT=8765
CHATWAIFU_LLM__PROVIDER=demo
# For an OpenAI-compatible server, set provider/model/base URL. Keep secrets only in this file.
# CHATWAIFU_LLM__PROVIDER=openai_compatible
# CHATWAIFU_LLM__MODEL=qwen3:8b
# CHATWAIFU_LLM__BASE_URL=http://127.0.0.1:11434/v1
# CHATWAIFU_LLM__API_KEY=
CHATWAIFU_TTS__PROVIDER=auto
CHATWAIFU_TTS__VOICE=Tingting
# `make demo` overrides TTS with its authenticated local Kokoro worker.
