CHATWAIFU_ENVIRONMENT=development
CHATWAIFU_LOG_LEVEL=INFO
CHATWAIFU_CONFIG_DIR=.local/config
CHATWAIFU_DATA_DIR=.local/data
CHATWAIFU_RUNTIME__HOST=127.0.0.1
CHATWAIFU_RUNTIME__PORT=8765
# Model roles are configured in Web under CONFIG / 设置. These legacy chat fields are only
# read as a first-run compatibility bootstrap and should not be used for new secrets.
CHATWAIFU_LLM__PROVIDER=demo
CHATWAIFU_TTS__DEFAULT_PROVIDER=qwen3_tts_mlx
CHATWAIFU_TTS__VOICE=Tingting
# `make demo` loads both authenticated local neural workers from the ignored profile.
