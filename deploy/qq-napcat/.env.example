# Copy to a private deployment directory as .env; do not commit the filled file.
# Set an explicit reviewed release image, preferably repository@sha256:digest.
# Official v4.18.28 multiarch digest verified on 2026-10-03; no floating latest.
NAPCAT_IMAGE=mlikiowa/napcat-docker@sha256:2cc70b45244ae3fabc657ffc3aaa4de8fb893518171e519659ab83d80e6d36b5

# Replace with `id -u` and `id -g` for the Linux deployment user.
NAPCAT_UID=
NAPCAT_GID=

# After the first successful QR login, set the character's QQ account (not the owner).
# The pinned image uses ACCOUNT with QQ -q to attempt quick login on container start.
# Empty starts the QR login flow; expired QQ credentials may still require scanning.
NAPCAT_ACCOUNT=

# Persistent host directory, resolved relative to docker-compose.yml if relative.
# Create config/ and qq/ below it before starting the container.
NAPCAT_DATA_DIR=./data

# Isolated host ports; container ports remain 3001 and 6099.
NAPCAT_WS_PORT=13001
NAPCAT_WEBUI_PORT=16099

# Generate at least 32 random bytes, e.g. openssl rand -hex 32.
# This is the WebUI password, separate from the OneBot WebSocket Token.
# WEBUI_TOKEN initializes an absent webui.json; it does not rotate an existing one.
NAPCAT_WEBUI_TOKEN=
