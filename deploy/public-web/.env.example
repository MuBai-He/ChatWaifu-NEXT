# Copy this file to .env. Keep the real value out of git.
SEARXNG_IMAGE=searxng/searxng:latest
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.9.3
SEARXNG_HOST_PORT=8080
CRAWL4AI_HOST_PORT=11235
# Use a resolver that is not rewritten to Mihomo Fake-IP in the deployment host.
SEARXNG_DNS_SERVER=1.1.1.1
CRAWL4AI_DNS_SERVER=1.1.1.1
CRAWL4AI_API_TOKEN=replace-with-a-random-long-token
CRAWL4AI_SECRET_KEY=replace-with-a-random-long-secret
