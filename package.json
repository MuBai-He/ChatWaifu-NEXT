{
  "name": "chatwaifu-next",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @chatwaifu/web dev",
    "dev:web": "pnpm --filter @chatwaifu/web dev:web",
    "dev:desktop-ui": "pnpm --filter @chatwaifu/web dev:desktop",
    "docs:dev": "pnpm --filter @chatwaifu/docs dev",
    "docs:build": "pnpm --filter @chatwaifu/docs build",
    "docs:preview": "pnpm --filter @chatwaifu/docs preview",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @chatwaifu/web build:web",
    "build:desktop-ui": "pnpm --filter @chatwaifu/web build:desktop",
    "build:windows-x64": "pnpm --filter @chatwaifu/desktop build:windows-x64",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "protocol:generate": "uv run python tools/generate_protocol_schemas.py && pnpm --filter @chatwaifu/protocol generate"
  },
  "devDependencies": {
    "prettier": "^3.8.2"
  }
}
