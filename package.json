{
  "name": "chatwaifu-next",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --filter @chatwaifu/web dev",
    "build": "pnpm -r --if-present build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "protocol:generate": "uv run python tools/generate_protocol_schemas.py && pnpm --filter @chatwaifu/protocol generate"
  },
  "devDependencies": {
    "prettier": "^3.8.2"
  }
}
